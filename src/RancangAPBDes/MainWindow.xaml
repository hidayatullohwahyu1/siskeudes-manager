<Window x:Class="RancangAPBDes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RancangAPBDes.Core"
        Title="Rancang APBDes – Simulasi Perencanaan &amp; Penganggaran Desa"
        FontFamily="{StaticResource FontUtama}" FontSize="13"
        Foreground="{StaticResource TeksUtama}" Background="{StaticResource LatarApp}"
        MinWidth="900" MinHeight="560" Width="1280" Height="760"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        DataContext="{x:Static core:AppState.Instance}">
    <Grid x:Name="Akar">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Skala" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Menu ============ -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Garis}" BorderThickness="0,0,0,1">
            <Menu x:Name="MenuUtama" Padding="4,2">
                <MenuItem Header="_File">
                    <MenuItem Header="Buka File Data…" Click="BukaFile_Click" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Buat File Data Baru…" Click="FileBaru_Click"/>
                    <MenuItem Header="Simpan Salinan Sebagai… (mis. ke flashdisk)" Click="SimpanSalinan_Click"/>
                    <Separator/>
                    <MenuItem Header="Buka Folder File Data" Click="FolderData_Click"/>
                    <MenuItem Header="Buka Folder Cadangan Otomatis" Click="FolderCadangan_Click"/>
                    <Separator/>
                    <MenuItem Header="Keluar" Click="Keluar_Click" InputGestureText="Alt+F4"/>
                </MenuItem>
                <MenuItem Header="_Parameter">
                    <MenuItem Header="Rekening APB Desa" Tag="0" Click="Parameter_Click"/>
                    <MenuItem Header="Sumber Dana" Tag="1" Click="Parameter_Click"/>
                    <MenuItem Header="Bidang" Tag="2" Click="Parameter_Click"/>
                    <MenuItem Header="Sub Bidang" Tag="3" Click="Parameter_Click"/>
                    <MenuItem Header="Referensi Kegiatan" Tag="4" Click="Parameter_Click"/>
                    <MenuItem Header="Satuan" Tag="5" Click="Parameter_Click"/>
                    <MenuItem Header="Aturan Batas Belanja" Tag="6" Click="Parameter_Click"/>
                    <Separator/>
                    <MenuItem Header="Pelaksana Kegiatan (Perangkat Desa)" Click="Pelaksana_Click"/>
                </MenuItem>
                <MenuItem Header="_Data Entri">
                    <MenuItem Header="Data Umum Desa" Click="DataUmum_Click"/>
                    <Separator/>
                    <MenuItem Header="Penganggaran">
                        <MenuItem Header="Isian Data Anggaran" Click="Isian_Click" InputGestureText="F3"/>
                        <MenuItem x:Name="MenuPosting" Header="Posting APBDes (kunci skenario)…" Click="Posting_Click"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Simulasi">
                    <MenuItem Header="Skenario Baru (kosong)…" Click="SkenarioBaru_Click"/>
                    <MenuItem Header="Salin Skenario Ini…" Click="SkenarioSalin_Click"/>
                    <MenuItem Header="Ganti Nama Skenario…" Click="SkenarioNama_Click"/>
                    <MenuItem Header="Hapus Skenario Ini…" Click="SkenarioHapus_Click"/>
                    <Separator/>
                    <MenuItem Header="Bandingkan Skenario (Semula – Menjadi)" Click="Banding_Click"/>
                </MenuItem>
                <MenuItem Header="_Laporan">
                    <MenuItem Header="Ringkasan APBDes (Beranda)" Click="Beranda_Click"/>
                    <MenuItem Header="Pratinjau &amp; Cetak Laporan…" Click="Cetak_Click" InputGestureText="Ctrl+P"/>
                    <MenuItem Header="Ekspor ke Excel…" Click="Ekspor_Click"/>
                </MenuItem>
                <MenuItem Header="_Tampilan">
                    <MenuItem Header="Perbesar" Click="Perbesar_Click" InputGestureText="Ctrl +"/>
                    <MenuItem Header="Perkecil" Click="Perkecil_Click" InputGestureText="Ctrl −"/>
                    <MenuItem Header="Ukuran Normal (100%)" Click="Normal_Click" InputGestureText="Ctrl+0"/>
                    <Separator/>
                    <MenuItem Header="Layar Penuh (untuk proyektor)" Click="LayarPenuh_Click" InputGestureText="F11"/>
                </MenuItem>
                <MenuItem Header="_Bantuan">
                    <MenuItem Header="Petunjuk Penggunaan" Click="Bantuan_Click" InputGestureText="F1"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ============ Bilah alat ============ -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Garis}" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <Button Content="Beranda" Style="{StaticResource TombolAlat}" Click="Beranda_Click" ToolTip="Ringkasan APBDes (F2)"/>
                <Button Content="Isian Data Anggaran" Style="{StaticResource TombolAlat}" Click="Isian_Click" ToolTip="Data Entri › Penganggaran (F3)"/>
                <Button Content="Bandingkan" Style="{StaticResource TombolAlat}" Click="Banding_Click" ToolTip="Bandingkan dua skenario"/>
                <Rectangle Width="1" Fill="{StaticResource Garis}" Margin="6,3"/>
                <TextBlock Text="Tahun" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox ItemsSource="{Binding DaftarTahun}" SelectedItem="{Binding TahunAktif}" MinWidth="76" Margin="0,0,8,0"
                          ToolTip="Tahun anggaran"/>
                <TextBlock Text="Skenario" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding SkenarioTahunIni}" SelectedItem="{Binding SkenarioAktif}"
                          DisplayMemberPath="Tampil" MinWidth="200" MaxWidth="360" Margin="0,0,6,0"
                          ToolTip="Pilih skenario anggaran"/>
                <Border x:Name="LencanaStatus" CornerRadius="3" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" FontWeight="SemiBold" FontSize="{StaticResource HurufKecil}"/>
                </Border>
                <Rectangle Width="1" Fill="{StaticResource Garis}" Margin="6,3"/>
                <Button Content="↶ Batalkan" Style="{StaticResource TombolAlat}" Click="Batalkan_Click" IsEnabled="{Binding BisaBatalkan}"
                        ToolTip="Batalkan perubahan terakhir (Ctrl+Z)"/>
                <Button Content="↷ Ulangi" Style="{StaticResource TombolAlat}" Click="Ulangi_Click" IsEnabled="{Binding BisaUlangi}"
                        ToolTip="Ulangi perubahan yang dibatalkan (Ctrl+Y)"/>
                <Rectangle Width="1" Fill="{StaticResource Garis}" Margin="6,3"/>
                <Button Content="Cetak" Style="{StaticResource TombolAlat}" Click="Cetak_Click" ToolTip="Pratinjau &amp; cetak laporan (Ctrl+P)"/>
                <Button Content="Excel" Style="{StaticResource TombolAlat}" Click="Ekspor_Click" ToolTip="Ekspor ke Excel"/>
                <Rectangle Width="1" Fill="{StaticResource Garis}" Margin="6,3"/>
                <Button Content="A−" Style="{StaticResource TombolAlat}" Click="Perkecil_Click" ToolTip="Perkecil tampilan (Ctrl −)"/>
                <TextBlock x:Name="TxtZoom" Text="100%" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="A+" Style="{StaticResource TombolAlat}" Click="Perbesar_Click" ToolTip="Perbesar tampilan (Ctrl +)"/>
            </WrapPanel>
        </Border>

        <!-- ============ Pemberitahuan posting ============ -->
        <Border Grid.Row="2" Background="{StaticResource KuningMuda}" BorderBrush="#E8C66A" BorderThickness="0,0,0,1" Padding="12,4"
                Visibility="{Binding SkenarioFinal, Converter={StaticResource BoolKeVis}}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Kuning}">
                <Run Text="Skenario ini sudah di-POSTING (terkunci) sehingga tidak bisa diubah." FontWeight="SemiBold"/>
                <Run Text="Untuk mencoba variasi: Simulasi › Salin Skenario Ini. Untuk mengubah: Data Entri › Penganggaran › Batalkan Posting."/>
            </TextBlock>
        </Border>

        <!-- ============ Isi ============ -->
        <ContentControl x:Name="Isi" Grid.Row="3" Margin="10,8,10,8" Focusable="False" HorizontalContentAlignment="Stretch"/>

        <!-- ============ Bilah status ============ -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Garis}" BorderThickness="0,1,0,0" Padding="8,3,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Sisa dana:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,3"/>
                    <ItemsControl ItemsSource="{Binding Hasil.PerSumberDana}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Chip" CornerRadius="9" Padding="7,1" Margin="0,0,4,3"
                                        Background="{StaticResource HijauMuda}" ToolTip="{Binding Nama}">
                                    <TextBlock x:Name="ChipTeks" Foreground="{StaticResource Hijau}" FontSize="12">
                                        <Run Text="{Binding Kode, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Sisa, Mode=OneWay, StringFormat={}{0:#,##0}}"/>
                                    </TextBlock>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kurang}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource MerahMuda}"/>
                                        <Setter TargetName="ChipTeks" Property="Foreground" Value="{StaticResource Merah}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TxtSisaAnggaran" VerticalAlignment="Center" Margin="4,0,0,3" FontSize="12"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,3">
                    <TextBlock Text="{Binding StatusSimpan}" FontSize="12" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarnaRedup}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GagalSimpan}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Merah}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding NamaFileSingkat}" ToolTip="{Binding NamaFile}" FontSize="12" Foreground="{StaticResource WarnaRedup}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
