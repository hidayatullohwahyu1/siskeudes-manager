<Application x:Class="RancangAPBDes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="FontUtama">Segoe UI, Tahoma, Arial</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolKeVis"/>

        <!-- Skala huruf tetap: 12 keterangan · 13 isi · 15 judul · 18 angka besar -->
        <sys:Double x:Key="HurufKecil">12</sys:Double>
        <sys:Double x:Key="HurufIsi">13</sys:Double>
        <sys:Double x:Key="HurufJudul">15</sys:Double>
        <sys:Double x:Key="HurufBesar">18</sys:Double>

        <!-- Palet: hijau pemerintahan desa, latar netral, teks gelap (kontras ≥ 4,5:1) -->
        <SolidColorBrush x:Key="Primer" Color="#1B5E20"/>
        <SolidColorBrush x:Key="PrimerGelap" Color="#13461A"/>
        <SolidColorBrush x:Key="PrimerMuda" Color="#EAF4EB"/>
        <SolidColorBrush x:Key="Pilihan" Color="#CFE8D3"/>
        <SolidColorBrush x:Key="LatarApp" Color="#E3E7EA"/>
        <SolidColorBrush x:Key="LatarPanel" Color="#EFF3F0"/>
        <SolidColorBrush x:Key="Garis" Color="#B7C1BB"/>
        <SolidColorBrush x:Key="GarisTegas" Color="#83908A"/>
        <SolidColorBrush x:Key="TeksUtama" Color="#121816"/>
        <SolidColorBrush x:Key="WarnaRedup" Color="#37413D"/>
        <SolidColorBrush x:Key="JudulForm" Color="#7A1717"/>
        <SolidColorBrush x:Key="Merah" Color="#931A12"/>
        <SolidColorBrush x:Key="MerahMuda" Color="#FDECEA"/>
        <SolidColorBrush x:Key="Hijau" Color="#13531E"/>
        <SolidColorBrush x:Key="HijauMuda" Color="#E3F2E5"/>
        <SolidColorBrush x:Key="Kuning" Color="#5A3A00"/>
        <SolidColorBrush x:Key="KuningMuda" Color="#FFF5D9"/>
        <LinearGradientBrush x:Key="LatarKepalaForm" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1F6024" Offset="0"/>
            <GradientStop Color="#18501D" Offset="1"/>
        </LinearGradientBrush>

        <!-- ================= Tombol ================= -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TeksUtama}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GarisTegas}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF4EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D3E9D6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TombolUtama" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primer}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimerGelap}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14461A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TombolBahaya" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource Merah}"/>
        </Style>

        <!-- Tombol datar di bilah alat -->
        <Style x:Key="TombolAlat" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <!-- ================= Isian ================= -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource GarisTegas}"/>
            <Setter Property="Foreground" Value="{StaticResource TeksUtama}"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F3F5F4"/>
                    <Setter Property="BorderBrush" Value="#C3CCC6"/>
                    <Setter Property="Foreground" Value="#121816"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="360"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource FontUtama}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource FontUtama}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="FontFamily" Value="{StaticResource FontUtama}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <!-- ================= Teks ================= -->
        <Style x:Key="Judul" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="SubJudul" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="TeksRedup" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WarnaRedup}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>

        <Style x:Key="Kartu" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Garis}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <!-- ================= Tabel ================= -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D6DDD8"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E2E8E4"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F2F6F3"/>
            <Setter Property="BorderBrush" Value="{StaticResource Garis}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinRowHeight" Value="25"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <!-- Selalu tampil: bila muncul-hilang, lebar kolom & tinggi baris saling memicu tanpa henti (aplikasi macet) -->
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9E4DC"/>
            <Setter Property="Foreground" Value="{StaticResource TeksUtama}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Garis}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE8D3"/>
                    <Setter Property="Foreground" Value="{StaticResource TeksUtama}"/>
                    <Setter Property="BorderBrush" Value="#CFE8D3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelTeks" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SelAngka" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SelAngkaTebal" TargetType="TextBlock" BasedOn="{StaticResource SelAngka}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
