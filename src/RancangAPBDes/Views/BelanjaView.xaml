<UserControl x:Class="RancangAPBDes.Views.BelanjaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:core="clr-namespace:RancangAPBDes.Core"
             xmlns:v="clr-namespace:RancangAPBDes.Views">
    <UserControl.Resources>
        <x:Array x:Key="DaftarPola" Type="sys:String">
            <sys:String>Swakelola</sys:String>
            <sys:String>Kerjasama Antar Desa</sys:String>
            <sys:String>Kerjasama dengan Pihak Ketiga</sys:String>
            <sys:String>Penyedia</sys:String>
        </x:Array>
        <x:Array x:Key="DaftarSifat" Type="sys:String">
            <sys:String>Fisik</sys:String>
            <sys:String>Non Fisik</sys:String>
        </x:Array>
    </UserControl.Resources>

    <ScrollViewer x:Name="Luar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid x:Name="Akar" MinHeight="480" Height="{Binding ViewportHeight, ElementName=Luar}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="Kol0" Width="3*" MinWidth="250"/>
            <ColumnDefinition x:Name="Kol1" Width="8"/>
            <ColumnDefinition x:Name="Kol2" Width="7*" MinWidth="380"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Bar0" Height="*"/>
            <RowDefinition x:Name="Bar1" Height="0"/>
            <RowDefinition x:Name="Bar2" Height="0"/>
        </Grid.RowDefinitions>

        <!-- ================= Daftar kegiatan ================= -->
        <Grid x:Name="PanelKiri" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Belanja per Kegiatan" Style="{StaticResource Judul}"/>
            <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                <Button Content="+ Kegiatan" Click="TambahKegiatan_Click" Style="{StaticResource TombolUtama}"
                        IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"
                        ToolTip="Tambah kegiatan pada sub bidang yang dipilih"/>
                <Button Content="Salin" Click="SalinKegiatan_Click"
                        IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"
                        ToolTip="Gandakan kegiatan terpilih beserta paket dan RAB-nya"/>
                <Button Content="Hapus" Click="HapusKegiatan_Click" Style="{StaticResource TombolBahaya}"
                        IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"
                        ToolTip="Hapus kegiatan terpilih"/>
            </WrapPanel>
            <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                <CheckBox x:Name="ChkHanyaIsi" Content="Sembunyikan sub bidang kosong" Margin="0,0,12,4"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,0,4">
                    <Hyperlink Click="BukaSemua_Click">Buka semua</Hyperlink>
                    <Run Text=" · "/>
                    <Hyperlink Click="LipatSemua_Click">Lipat semua</Hyperlink>
                </TextBlock>
            </WrapPanel>
            <ListBox x:Name="Daftar" Grid.Row="3" BorderBrush="{StaticResource Garis}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     HorizontalContentAlignment="Stretch" SelectionChanged="Daftar_SelectionChanged"
                     KeyDown="Daftar_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEF1F5"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:NodePohon}">
                        <Grid Margin="{Binding Indent}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Panah}" FontSize="16" VerticalAlignment="Top" Cursor="Hand"
                                       Foreground="{StaticResource Primer}" Padding="2,0"
                                       MouseLeftButtonDown="Panah_MouseDown" Tag="{Binding}"/>
                            <TextBlock x:Name="Teks" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="{Binding Kode, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="{Binding Nama, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock x:Name="Angka" Grid.Column="2" Text="{Binding Total, StringFormat={}{0:#,##0}}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Jenis}" Value="B">
                                <Setter TargetName="Teks" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Teks" Property="Foreground" Value="{StaticResource PrimerGelap}"/>
                                <Setter TargetName="Angka" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kosong}" Value="True">
                                <Setter TargetName="Teks" Property="Foreground" Value="#7A8494"/>
                                <Setter TargetName="Angka" Property="Foreground" Value="#7A8494"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter x:Name="Pemisah" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ToolTip="Geser untuk mengubah ukuran"/>

        <!-- ================= Panel kanan ================= -->
        <Grid x:Name="PanelKanan" Grid.Column="2">
            <!-- Belum memilih -->
            <Border x:Name="PanelKosong" Style="{StaticResource Kartu}" VerticalAlignment="Top" Margin="0">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource TeksRedup}" FontSize="16"
                           Text="Pilih sub bidang atau kegiatan di sebelah kiri. Untuk menambah kegiatan, pilih sub bidangnya lalu tekan &quot;+ Kegiatan&quot;."/>
            </Border>

            <!-- Sub bidang dipilih -->
            <ScrollViewer x:Name="PanelSub" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="TxtSubJudul" Style="{StaticResource SubJudul}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSubTotal" Style="{StaticResource TeksRedup}" Margin="0,0,0,10"/>
                    <Button Content="+ Kegiatan baru (kosong) di sub bidang ini" Click="TambahKegiatan_Click" HorizontalAlignment="Left"
                            Style="{StaticResource TombolUtama}" IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"/>
                    <TextBlock Text="Atau pilih dari referensi kegiatan:" Style="{StaticResource SubJudul}"/>
                    <TextBlock x:Name="TxtRefKosong" Style="{StaticResource TeksRedup}" Visibility="Collapsed"
                               Text="Belum ada referensi kegiatan untuk sub bidang ini. Anda bisa menambahkannya di halaman Referensi &amp; Aturan (atau impor dari Excel)."/>
                    <ItemsControl x:Name="DaftarRef">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:RefKegiatan}">
                                <Border Style="{StaticResource Kartu}" Margin="0,0,0,6" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                            <Run Text="{Binding Kode, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Nama, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="Tambahkan" Click="TambahDariRef_Click" Tag="{Binding}"
                                                Margin="10,0,0,0" VerticalAlignment="Center"
                                                IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Kegiatan dipilih -->
            <ScrollViewer x:Name="PanelKegiatan" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel x:Name="IsiKegiatan" Margin="0,0,6,0">
                    <Border Background="White" BorderBrush="{StaticResource Garis}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="{Binding Kode, Mode=OneWay}"/>
                                <Run Text="{Binding Nama, Mode=OneWay}"/>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pagu kegiatan" Style="{StaticResource TeksRedup}" TextAlignment="Right" FontSize="13"/>
                                <TextBlock Text="{Binding Total, StringFormat=Rp {0:#,##0}}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimerGelap}" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Header="Data Kegiatan" IsExpanded="True" Margin="0,10,0,0" FontWeight="SemiBold">
                        <Grid Margin="4,10,0,0" TextElement.FontWeight="Normal">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="150"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Sub Bidang" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="CmbSub" Grid.Column="1" Margin="0,0,0,8"
                                      ItemsSource="{Binding Referensi.SubBidang, Source={x:Static core:AppState.Instance}}"
                                      SelectedValuePath="Kode" SelectedValue="{Binding KodeSubBidang}"
                                      IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tampil}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Nama Kegiatan" Style="{StaticResource Label}"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False"
                                         IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"/>
                                <Button x:Name="BtnPilihRef" Grid.Column="1" Content="Referensi ▾" Margin="6,0,0,0" Click="PilihRef_Click" VerticalAlignment="Top"
                                        IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"
                                        ToolTip="Pilih nama kegiatan dari referensi"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="No. urut kegiatan" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="70" Text="{Binding NoUrut, UpdateSourceTrigger=LostFocus}" TextAlignment="Right"
                                             IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"
                                             ToolTip="Nomor kegiatan di dalam sub bidang (01, 02, …)"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Lokasi" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Lokasi, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"/>
                            <TextBlock Grid.Row="3" Text="Waktu" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Waktu, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"/>

                            <TextBlock Grid.Row="4" Text="Pelaksana (PPKD)" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" IsEditable="True"
                                      ItemsSource="{Binding DaftarPelaksana, Source={x:Static core:AppState.Instance}}"
                                      Text="{Binding Pelaksana, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"/>
                            <TextBlock Grid.Row="5" Text="Keluaran" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Keluaran, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"/>

                            <TextBlock Grid.Row="6" Text="Volume keluaran" Style="{StaticResource Label}"/>
                            <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding VolumeKeluaran, StringFormat={}{0:#,##0.##}, UpdateSourceTrigger=LostFocus}" TextAlignment="Right"
                                         IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"/>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" IsEditable="True"
                                          ItemsSource="{Binding DaftarSatuan, Source={x:Static core:AppState.Instance}}"
                                          Text="{Binding SatuanKeluaran, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}"/>
                            </Grid>
                            <TextBlock Grid.Row="7" Text="Catatan rapat" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Catatan, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"
                                     ToolTip="Catatan hasil musyawarah untuk kegiatan ini (tidak masuk Siskeudes)"/>
                        </Grid>
                    </Expander>

                    <!-- Paket -->
                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Paket Kegiatan" Style="{StaticResource SubJudul}" Margin="0,0,0,6" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="1" IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}">
                            <Button Content="+ Paket" Click="TambahPaket_Click"/>
                            <Button Content="Salin Paket" Click="SalinPaket_Click"/>
                            <Button Content="Hapus Paket" Click="HapusPaket_Click" Style="{StaticResource TombolBahaya}"/>
                        </WrapPanel>
                    </Grid>
                    <DataGrid x:Name="TabelPaket" ItemsSource="{Binding Paket}" MinHeight="80"
                              IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"
                              SelectionChanged="TabelPaket_SelectionChanged" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama Paket" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="150"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Nilai (Rp)" Binding="{Binding Total, Mode=OneWay, StringFormat={}{0:#,##0}}" IsReadOnly="True"
                                                Width="130" MinWidth="120" ElementStyle="{StaticResource SelAngkaTebal}"/>
                            <DataGridTemplateColumn Header="Sumber Dana" Width="85" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SumberDana}" Style="{StaticResource SelTeks}" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DaftarSumberDana, Source={x:Static core:AppState.Instance}}"
                                                  SelectedValuePath="Kode" SelectedValue="{Binding SumberDana, UpdateSourceTrigger=PropertyChanged}"
                                                  TextSearch.TextPath="Kode" DisplayMemberPath="Tampil" MinHeight="28" Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridComboBoxColumn Header="Pola" Width="130" MinWidth="110"
                                                    ItemsSource="{StaticResource DaftarPola}" SelectedItemBinding="{Binding Pola}"/>
                            <DataGridComboBoxColumn Header="Sifat" Width="105" MinWidth="95"
                                                    ItemsSource="{StaticResource DaftarSifat}" SelectedItemBinding="{Binding Sifat}"/>
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetOutput, StringFormat={}{0:#,##0.##}}" Width="75" MinWidth="70"
                                                ElementStyle="{StaticResource SelAngka}" EditingElementStyle="{StaticResource EditAngka}"/>
                            <DataGridTemplateColumn Header="Satuan" Width="110" MinWidth="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Satuan}" Style="{StaticResource SelTeks}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DaftarSatuan, Source={x:Static core:AppState.Instance}}" IsEditable="True"
                                                  Text="{Binding Satuan, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Uraian Output" Binding="{Binding UraianOutput, UpdateSourceTrigger=PropertyChanged}" Width="1.3*" MinWidth="130"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rincian RAB -->
                    <TextBlock x:Name="TxtJudulRab" Style="{StaticResource SubJudul}" Margin="0,16,0,6"/>
                    <TextBlock x:Name="TxtTanpaPaket" Style="{StaticResource TeksRedup}" Visibility="Collapsed" Margin="0,0,0,8"
                               Text="Pilih salah satu paket di atas (atau tambah paket) untuk mengisi rincian RAB."/>
                    <v:RincianEditor x:Name="EdRab" MinHeight="220" LabelTotal="Total paket" TampilkanKeterangan="False"
                                     RekeningSource="{Binding RekeningBelanja, Source={x:Static core:AppState.Instance}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
