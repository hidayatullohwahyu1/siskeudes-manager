<UserControl x:Class="RancangAPBDes.Views.ReferensiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <x:Array x:Key="DaftarJenis" Type="sys:String">
            <sys:String>Maksimal</sys:String>
            <sys:String>Minimal</sys:String>
        </x:Array>
        <x:Array x:Key="DaftarDasar" Type="sys:String">
            <sys:String>Total Belanja</sys:String>
            <sys:String>Pagu Sumber Dana</sys:String>
        </x:Array>
    </UserControl.Resources>
    <ScrollViewer x:Name="Luar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid MinHeight="480" Height="{Binding ViewportHeight, ElementName=Luar}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Referensi &amp; Aturan" Style="{StaticResource Judul}"/>
        <Border Grid.Row="1" Background="{StaticResource KuningMuda}" BorderBrush="#E8C66A" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,4,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Kuning}"
                       Text="Penting: kode rekening dan referensi kegiatan bawaan hanyalah CONTOH. Cocokkan dengan Siskeudes desa Anda (menu Laporan ▸ Parameter), lalu perbaiki di sini atau impor dari file Excel (kolom A = kode, kolom B = nama). Referensi berlaku untuk semua skenario di file ini."/>
        </Border>
        <WrapPanel Grid.Row="2">
            <Button Content="Lengkapi dari bawaan" Click="Lengkapi_Click"
                    ToolTip="Tambahkan isi bawaan yang belum ada tanpa menimpa yang sudah Anda ubah"/>
        </WrapPanel>
        <TabControl Grid.Row="3" x:Name="Tab" Padding="10">
            <TabItem Header="Kode Rekening">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="+ Tambah" Tag="rekening" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="rekening" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                        <Button Content="Impor dari Excel…" Tag="rekening" Click="Impor_Click"/>
                        <Button Content="Urutkan" Tag="rekening" Click="Urutkan_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbRekening" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode (4 = pendapatan, 5 = belanja, 6.1/6.2 = pembiayaan)" Binding="{Binding Kode}" Width="240" MinWidth="160"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Nama Rekening" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="220"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Sumber Dana">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="+ Tambah" Tag="sumberdana" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="sumberdana" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbSumberDana" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="140" MinWidth="140" ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Nama Sumber Dana" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="220"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Bidang">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="+ Tambah" Tag="bidang" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="bidang" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbBidang" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="120" MinWidth="120" ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Nama Bidang" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="220"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Sub Bidang">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="+ Tambah" Tag="subbidang" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="subbidang" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbSubBidang" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode (mis. 02.03)" Binding="{Binding Kode}" Width="160" MinWidth="160" ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Nama Sub Bidang" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="220"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Referensi Kegiatan">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="+ Tambah" Tag="kegiatan" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="kegiatan" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                        <Button Content="Impor dari Excel…" Tag="kegiatan" Click="Impor_Click"/>
                        <Button Content="Urutkan" Tag="kegiatan" Click="Urutkan_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbKegiatan" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode (mis. 02.03.01)" Binding="{Binding Kode}" Width="180" MinWidth="180" ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Nama Kegiatan" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="220"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Satuan">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="+ Tambah" Tag="satuan" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="satuan" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbSatuan" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Satuan" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="200"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Aturan Batas">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource TeksRedup}" Margin="0,0,0,8"
                               Text="Aturan dipakai untuk peringatan di halaman Ringkasan. Kosongkan Awalan/Sumber Dana untuk mencakup semuanya. Contoh: Awalan Sub Bidang 01.01, Maksimal 30% dari Total Belanja. Sesuaikan persen dengan Perbup/aturan tahun berjalan."/>
                    <WrapPanel Grid.Row="1">
                        <Button Content="+ Tambah" Tag="aturan" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                        <Button Content="Hapus" Tag="aturan" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
                    </WrapPanel>
                    <DataGrid x:Name="TbAturan" Grid.Row="2">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Aktif" Width="70" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Aktif, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nama Aturan" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="200"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridComboBoxColumn Header="Jenis" Width="110" MinWidth="110" ItemsSource="{StaticResource DaftarJenis}" SelectedItemBinding="{Binding Jenis}"/>
                            <DataGridTextColumn Header="Persen (%)" Binding="{Binding Persen, StringFormat={}{0:0.##}}" Width="95" MinWidth="95"
                                                ElementStyle="{StaticResource SelAngka}" EditingElementStyle="{StaticResource EditAngka}"/>
                            <DataGridTextColumn Header="Awalan Sub Bidang" Binding="{Binding AwalanSubBidang}" Width="120" MinWidth="120"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Awalan Rekening" Binding="{Binding AwalanRekening}" Width="115" MinWidth="115"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridTextColumn Header="Sumber Dana" Binding="{Binding SumberDana}" Width="100" MinWidth="100"
                                                ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                            <DataGridComboBoxColumn Header="Dibanding dengan" Width="160" MinWidth="160" ItemsSource="{StaticResource DaftarDasar}" SelectedItemBinding="{Binding Dasar}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </ScrollViewer>
</UserControl>
