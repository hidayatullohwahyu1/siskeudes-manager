<UserControl x:Class="RancangAPBDes.Views.PendapatanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:RancangAPBDes.Core"
             xmlns:v="clr-namespace:RancangAPBDes.Views">
    <ScrollViewer x:Name="Luar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Grid MinHeight="480" Height="{Binding ViewportHeight, ElementName=Luar}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Pendapatan &amp; Pembiayaan" Style="{StaticResource Judul}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource TeksRedup}" Margin="0,0,0,10"
                   Text="Isi perkiraan pendapatan desa per rekening beserta sumber dananya. Jumlah per sumber dana menjadi PAGU yang dibagi ke kegiatan di halaman Belanja. SiLPA tahun lalu dimasukkan di Penerimaan Pembiayaan."/>
        <TabControl Grid.Row="2" x:Name="Tab" Padding="10">
            <TabItem Header="Pendapatan (4)">
                <v:RincianEditor x:Name="EdPendapatan" LabelTotal="Total pendapatan"
                                 RekeningSource="{Binding RekeningPendapatan, Source={x:Static core:AppState.Instance}}"/>
            </TabItem>
            <TabItem Header="Penerimaan Pembiayaan (6.1)">
                <v:RincianEditor x:Name="EdTerima" LabelTotal="Total penerimaan pembiayaan"
                                 RekeningSource="{Binding RekeningPenerimaanPembiayaan, Source={x:Static core:AppState.Instance}}"/>
            </TabItem>
            <TabItem Header="Pengeluaran Pembiayaan (6.2)">
                <v:RincianEditor x:Name="EdKeluar" LabelTotal="Total pengeluaran pembiayaan"
                                 RekeningSource="{Binding RekeningPengeluaranPembiayaan, Source={x:Static core:AppState.Instance}}"/>
            </TabItem>
        </TabControl>
    </Grid>
    </ScrollViewer>
</UserControl>
