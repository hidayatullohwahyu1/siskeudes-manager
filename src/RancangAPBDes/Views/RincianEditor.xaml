<UserControl x:Class="RancangAPBDes.Views.RincianEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:RancangAPBDes.Core"
             xmlns:v="clr-namespace:RancangAPBDes.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,2" IsEnabled="{Binding BisaUbah, Source={x:Static core:AppState.Instance}}">
            <Button x:Name="BtnTambah" Content="+ Tambah Baris" Click="Tambah_Click" Style="{StaticResource TombolUtama}"
                    ToolTip="Tambah baris rincian di bawah baris terpilih"/>
            <Button Content="Salin Baris" Click="Salin_Click" ToolTip="Gandakan baris terpilih"/>
            <Button Content="▲ Naik" Click="Naik_Click" ToolTip="Pindahkan baris ke atas"/>
            <Button Content="▼ Turun" Click="Turun_Click" ToolTip="Pindahkan baris ke bawah"/>
            <Button Content="Hapus Baris" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"
                    ToolTip="Hapus baris terpilih (bisa dibatalkan dengan tombol Batalkan)"/>
        </WrapPanel>

        <DataGrid x:Name="Tabel" Grid.Row="1"
                  IsReadOnly="{Binding TidakBisaUbah, Source={x:Static core:AppState.Instance}}"
                  CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Rekening" Width="1.2*" MinWidth="130" SortMemberPath="KodeRekening">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KodeRekening}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding NamaRekening}" Foreground="{StaticResource WarnaRedup}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding RekeningSource, RelativeSource={RelativeSource AncestorType=v:RincianEditor}}"
                                      SelectedValuePath="Kode"
                                      SelectedValue="{Binding KodeRekening, UpdateSourceTrigger=PropertyChanged}"
                                      TextSearch.TextPath="Kode" IsTextSearchEnabled="True" MinHeight="28" Padding="4,2">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tampil}" TextWrapping="Wrap" MaxWidth="560"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Header="Uraian" Binding="{Binding Uraian, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2*" MinWidth="140"
                                    ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>

                <DataGridTextColumn Header="Vol." Binding="{Binding Volume, StringFormat={}{0:#,##0.##}}"
                                    Width="70" MinWidth="65"
                                    ElementStyle="{StaticResource SelAngka}" EditingElementStyle="{StaticResource EditAngka}"/>

                <DataGridTemplateColumn Header="Satuan" Width="90" MinWidth="80" SortMemberPath="Satuan">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Satuan}" Style="{StaticResource SelTeks}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DaftarSatuan, Source={x:Static core:AppState.Instance}}"
                                      IsEditable="True" Text="{Binding Satuan, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="28" Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Harga Satuan (Rp)" Binding="{Binding HargaSatuan, StringFormat={}{0:#,##0.##}}"
                                    Width="120" MinWidth="115"
                                    ElementStyle="{StaticResource SelAngka}" EditingElementStyle="{StaticResource EditAngka}"/>

                <DataGridTextColumn Header="Jumlah (Rp)" Binding="{Binding Jumlah, Mode=OneWay, StringFormat={}{0:#,##0.##}}"
                                    IsReadOnly="True" Width="130" MinWidth="125" ElementStyle="{StaticResource SelAngkaTebal}"/>

                <DataGridTemplateColumn Header="Sumber Dana" Width="80" MinWidth="70" SortMemberPath="SumberDana">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SumberDana}" Style="{StaticResource SelTeks}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DaftarSumberDana, Source={x:Static core:AppState.Instance}}"
                                      SelectedValuePath="Kode" SelectedValue="{Binding SumberDana, UpdateSourceTrigger=PropertyChanged}"
                                      TextSearch.TextPath="Kode" DisplayMemberPath="Tampil" MinHeight="28" Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="KolKeterangan" Header="Keterangan" Binding="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" MinWidth="110"
                                    ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="{StaticResource PrimerMuda}" BorderBrush="{StaticResource Garis}" BorderThickness="1,0,1,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TeksRedup}" FontSize="13" VerticalAlignment="Center"
                           Text="Klik dua kali sel untuk mengubah. Desimal memakai koma (contoh 2,5). Tekan Enter untuk selesai."/>
                <TextBlock x:Name="TxtTotal" Grid.Column="1" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
