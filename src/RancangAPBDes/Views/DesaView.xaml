<UserControl x:Class="RancangAPBDes.Views.DesaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Data Desa" Style="{StaticResource Judul}"/>
            <TextBlock Style="{StaticResource TeksRedup}" Margin="0,0,0,14"
                       Text="Data ini dipakai di kepala laporan dan untuk menyusun kode lengkap seperti di Siskeudes (contoh kode desa 04.2002 → kegiatan 04.2002.01.01.01.). Berlaku untuk semua skenario di file ini."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="220"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Nama Desa" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding NamaDesa, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="1" Text="Kode Desa (Siskeudes)" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding KodeDesa, UpdateSourceTrigger=LostFocus}"
                         ToolTip="Contoh: 04.2002 (lihat awalan kode kegiatan di Siskeudes)"/>
                <TextBlock Grid.Row="2" Text="Kecamatan" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Kecamatan, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="3" Text="Kabupaten" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Kabupaten, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="4" Text="Kepala Desa" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding KepalaDesa, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="5" Text="Sekretaris Desa" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Text="{Binding Sekdes, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="6" Text="Kaur Keuangan" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Text="{Binding KaurKeuangan, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Row="7" Text="Tempat tanda tangan" Style="{StaticResource Label}"/>
                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Text="{Binding TempatTtd, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Muncul di laporan cetak, mis. nama desa"/>
            </Grid>

            <TextBlock Text="Perangkat Desa / Pelaksana Kegiatan (PPKD)" Style="{StaticResource SubJudul}"/>
            <TextBlock Style="{StaticResource TeksRedup}" Margin="0,0,0,6"
                       Text="Nama-nama ini muncul sebagai pilihan Pelaksana di halaman Belanja."/>
            <WrapPanel>
                <Button Content="+ Tambah" Click="Tambah_Click" Style="{StaticResource TombolUtama}"/>
                <Button Content="Hapus" Click="Hapus_Click" Style="{StaticResource TombolBahaya}"/>
            </WrapPanel>
            <DataGrid x:Name="TabelPerangkat" ItemsSource="{Binding Perangkat}" MinHeight="80">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="160"
                                        ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                    <DataGridTextColumn Header="Jabatan" Binding="{Binding Jabatan, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="160"
                                        ElementStyle="{StaticResource SelTeks}" EditingElementStyle="{StaticResource EditTeks}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
